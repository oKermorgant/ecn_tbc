            <radius>0.01</radius>
          </cylinder>
        </geometry>
      </visual>
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.5</horizontal_fov>
            <image>
              <width>800</width>
              <height>600</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>pioneer/camera</topic>
        </sensor>
    </link>
