          <ambient>0.89375 0.72875 0.2625 1</ambient>
        </material>
      </visual>
      <visual name='base_link_fixed_joint_lump__front_sonar_visual_2'>
        <pose>-0.198 0 0.208 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>p3dx_meshes/front_sonar.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Yellow</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
          <diffuse>0.89375 0.72875 0.2625 1</diffuse>
          <ambient>0.89375 0.72875 0.2625 1</ambient>
        </material>
      </visual>
      <visual name='base_link_fixed_joint_lump__top_plate_visual_3'>
