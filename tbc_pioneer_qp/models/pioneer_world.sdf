        </geometry>
        <material>
          <diffuse>1 0 0 1</diffuse>
          <ambient>1 0 0 1</ambient>
        </material>
      </visual>
    </link>
    <joint name='tilt' type='revolute'>
      <pose relative_to='cam_pan'>0 0 0 0 0 0</pose>
      <parent>cam_pan</parent>
      <child>camera</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
