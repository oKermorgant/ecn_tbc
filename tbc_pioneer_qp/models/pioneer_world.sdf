          </script>
          <diffuse>0.625 0.625 0.625 1</diffuse>
          <ambient>0.625 0.625 0.625 1</ambient>
        </material>
      </visual>
    </link>
    <joint name='caster_swivel_hubcap_joint' type='revolute'>
      <pose relative_to='caster_swivel'>-0.026 0 -0.016 0 0 0</pose>
      <parent>caster_swivel</parent>
      <child>caster_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
